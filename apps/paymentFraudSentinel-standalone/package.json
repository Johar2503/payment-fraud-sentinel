{
	"name": "payment-fraud-sentinel-standalone",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Standalone (non-shell) React + Vite frontend for payment_fraud_sentinel_v2.pipe, talking to the RocketRide SDK directly. Local/demo only — see README.",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"smoke": "node --env-file=.env scripts/smoke.mjs"
	},
	"dependencies": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"rocketride": "file:../../.rocketride/client/rocketride.tgz"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["esbuild"]
	},
	"devDependencies": {
		"@types/node": "^20.17.9",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"postcss": "^8.4.49",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.6.3",
		"vite": "^5.4.11"
	}
}
