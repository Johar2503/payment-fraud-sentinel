# Standalone frontend config. Copy to .env and fill in.
#
# WARNING: this is a BROWSER app that talks to the RocketRide SDK directly.
# Every VITE_* value below is compiled into the client bundle and is visible
# to anyone who loads the page. Use a scoped/short-lived key and do NOT deploy
# this build to a public URL. Local / demo use only.

# Development server (run / validate / iterate) — same pair the shell app uses.
VITE_ROCKETRIDE_URI=https://staging.rocketride.ai:443
VITE_ROCKETRIDE_APIKEY=

# Needed for server-side ${ROCKETRIDE_ANTHROPIC_KEY} substitution in the pipeline's
# LLM nodes (extraction, agent, verify, chat). Without it those nodes error.
VITE_ROCKETRIDE_ANTHROPIC_KEY=

# Required by the managed rocketride_sql / rocketride_* cloud DB nodes (vendor lookup in
# the invoice flow, risk_history writeback in the decision flow) to resolve the account's
# Postgres credential. This is the signed-in account user id (getAccountInfo().userId) —
# the same value as ROCKETRIDE_CLIENT_ID in the repo-root .env. Not a secret, but it IS
# bundled into the browser build like every VITE_* var, so keep .env local/demo only.
# Without it those nodes fail with: password authentication failed for user "rocketride".
VITE_ROCKETRIDE_CLIENT_ID=

# scripts/smoke.mjs (Node connectivity check) reads these NON-prefixed names via --env-file:
ROCKETRIDE_URI=https://staging.rocketride.ai:443
ROCKETRIDE_APIKEY=
