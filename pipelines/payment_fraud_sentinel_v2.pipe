			},
			"ui": {
				"position": {
					"x": 20,
					"y": 240
				},
				"measured": {
					"width": 150,
					"height": 66
				}
			}
		},
		{
			"id": "hash_1",
			"provider": "hash",
			"config": {},
			"input": [
				{
					"lane": "tags",
					"from": "webhook_invoice"
				}
			],
			"ui": {
				"position": {
					"x": 220,
					"y": 240
				},
				"measured": {
					"width": 150,
					"height": 66
				}
			}
		},
		{
			"id": "parse_1",
			"provider": "parse",
			"config": {},
			"input": [
				{
					"lane": "tags",
					"from": "hash_1"
				}
			],
			"ui": {
				"position": {
					"x": 420,
					"y": 240
				},
				"measured": {
					"width": 150,
					"height": 66
				}
			}
		},
		{
			"id": "preprocessor_langchain_1",
			"provider": "preprocessor_langchain",
			"config": {
				"profile": "default",
				"default": {
					"splitter": "RecursiveCharacterTextSplitter",
					"mode": "tokens",
					"tokens": 1000
				},
				"parameters": {}
			},
			"input": [
				{
					"lane": "text",
					"from": "parse_1"
				}
			],
			"ui": {
				"position": {
					"x": 620,
					"y": 140
				},
				"measured": {
					"width": 150,
					"height": 66
				}
			}
		},
		{
			"id": "extract_facts_1",
			"provider": "extract_facts",
			"config": {
				"profile": "default",
				"default": {
					"fields": [
						{
							"column": "invoice_number",
							"type": "text",
							"defval": ""
						},
						{
							"column": "vendor_name",
							"type": "text",
							"defval": ""
						},
						{
							"column": "vendor_bank_account",
							"type": "text",
							"defval": ""
						},
						{
							"column": "po_number",
							"type": "text",
							"defval": ""
						},
						{
							"column": "invoice_date",
							"type": "date",
							"defval": ""
						},
						{
							"column": "due_date",
							"type": "date",
							"defval": ""
						},
						{
							"column": "amount",
							"type": "decimal",
							"defval": ""
						},
						{
							"column": "currency",
							"type": "text",
							"defval": ""
						},
						{
							"column": "tax_amount",
							"type": "decimal",
							"defval": ""
						},
						{
							"column": "line_item_description",
							"type": "text",
							"defval": ""
						}
					],
					"validate": false,
					"include_provenance": true
				},
				"parameters": {}
			},
			"input": [
				{
					"lane": "documents",
					"from": "preprocessor_langchain_1"
				}
			],
			"ui": {
				"position": {
					"x": 820,
					"y": 140
				},
				"measured": {
					"width": 150,
					"height": 66
				}
			}
		},
		{
			"id": "normalize_facts_1",
			"provider": "normalize_facts",
			"config": {
				"profile": "default",
				"default": {
					"label_field": "line_item_description",
					"value_field": "amount",
					"default_currency": "USD",
					"decimal_format": "auto",
					"label_to_metric": {}
				},
				"parameters": {}
			},
			"input": [
				{
					"lane": "answers",
					"from": "extract_facts_1"
				}
			],
			"ui": {
				"position": {
					"x": 1020,
					"y": 140
				},
				"measured": {
					"width": 150,
					"height": 66
				}
			}
		},
		{
			"id": "schema_validate_1",
			"provider": "schema_validate",
			"config": {
				"profile": "default",
				"default": {
					"amount_field": "amount",
					"currency_field": "currency",
					"metric_field": "line_item_description",
					"category_field": "line_item_description",
					"category_metric_map": {},
					"sign": "off",
					"require_provenance": "error"
				},
				"parameters": {}
			},
			"input": [
				{
					"lane": "answers",
					"from": "normalize_facts_1"
				}
			],
			"ui": {
				"position": {
					"x": 1220,
					"y": 140
				},
				"measured": {
					"width": 150,
					"height": 66
				}
			}
		},
		{
			"id": "answer_documents_facts",
			"provider": "answer_documents",
			"config": {},
			"input": [
				{
					"lane": "answers",
					"from": "schema_validate_1"
				}
			],
			"ui": {
				"position": {
					"x": 1420,
					"y": 140
				},
				"measured": {
					"width": 150,
					"height": 66
				}
			}
		},
		{
			"id": "question_invoice",
			"provider": "question",
			"config": {
				"type": "question"
			},
			"input": [
				{
					"lane": "text",
					"from": "parse_1"
				}
			],
			"ui": {
				"position": {
					"x": 620,
					"y": 420
				},
				"measured": {
					"width": 150,
					"height": 66
				}
			}
		},
		{
			"id": "prompt_case",
			"provider": "prompt",
			"config": {
				"instructions": [
					"You are the triage controller for Payment Fraud Sentinel. You receive one supplier invoice (the question text) plus one context document: the audited/normalised extracted facts. You produce the complete case record for the human approval queue in a single pass.",
					"Step 0 - processability gate (do this FIRST, before any tool): look for the context facts document. If NO facts/context document is attached to this request at all, OR it is empty, OR it has NO non-empty vendor_name AND NO non-empty amount AND NO non-empty invoice_number, then the upload could not be parsed into an invoice. In that case: do NOT call any tool, do NOT query the vendor database, do NOT run Python or risk analysis, do NOT narrate or explain, do NOT write any sentence such as 'I need to check' - your ENTIRE response must be exactly this one JSON object and nothing else (only the summary wording may vary): {\"queue_status\":\"pending_review\",\"unprocessable\":true,\"invoice\":{\"invoice_number\":\"\",\"vendor_name\":\"\",\"amount\":\"\",\"currency\":\"\"},\"facts\":null,\"amount_analysis\":{\"invoice_amount\":0,\"vendor_mean_amount\":null,\"ratio_vs_mean\":null,\"over_2x_mean\":false},\"vendor\":{\"found\":false,\"vendor_id\":null,\"mean_amount\":null,\"bank_account_known\":false,\"amount_over_2x_mean\":false,\"days_since_first_seen\":null},\"deterministic_hold\":false,\"rules_fired\":[],\"risk\":{\"risk_score\":50,\"risk_level\":\"high\",\"flags\":[{\"type\":\"unprocessable_document\",\"evidence\":\"extract_facts returned an empty/near-empty facts document; the upload could not be read as an invoice\"}]},\"verification\":{\"status\":\"pending\",\"result\":null},\"summary\":\"Document could not be parsed into an invoice - routed to manual review.\"}. Only when the facts document has real content do you continue to Step 1.",
					"You have a real Python code-execution tool. For any processable invoice (i.e. once the Step 0 gate has passed) you MUST invoke it for real for the Step 2 computation. NEVER write tool-call syntax as plain text, NEVER label output 'simulated', and NEVER invent a vendor record or a computation result. If a tool call errors, report it rather than fabricating data. Other than the Step 0 fast path, an answer whose Step 2 numbers did not come from a genuine Python tool call is invalid.",
					"Step 1 - vendor lookup: the vendor master is the JSON array in the next instruction (VENDOR_MASTER) - 50 records, each { vendor_id, name, known_bank_accounts (array), historical_invoice_amounts (array of numbers), first_seen_date, risk_score, risk_history (array) }. Find the record whose name matches the invoice vendor_name: compare case-insensitively, ignore surrounding punctuation/whitespace and common company suffixes (Inc, Ltd, LLC, Co, Corp, GmbH, Group, Holdings, Partners). Accept an unambiguous close match as found. If exactly one record matches, it is the vendor row for the rest of this case. If none match or the match is ambiguous, set vendor.found=false, vendor_id=null, and treat the vendor as unknown. Do NOT call a tool for this step - read directly from VENDOR_MASTER.",
					"VENDOR_MASTER = [{\"vendor_id\":\"V0001\",\"name\":\"Alpine Ski Systems Group\",\"known_bank_accounts\":[\"ACH-****3641\",\"ACH-****6469\"],\"historical_invoice_amounts\":[13713.76,25861.58,18921.29,23275.95,24536.33,11469.98,14537.03,22291.46,19883.48,15212.59,11386.39,24749.45,15120.88,16168.18,62366.2],\"first_seen_date\":\"2025-12-23\",\"risk_score\":10,\"risk_history\":[]},{\"vendor_id\":\"V0002\",\"name\":\"Graphic Design Institute Holdings Group\",\"known_bank_accounts\":[\"WIRE-****2053\"],\"historical_invoice_amounts\":[22746.73,33178.29,29639.41,36749.65,19403.67,21880.75,23450.69,21357,19772.59,17781.69,16387.82,19508.68,30325.91,23118.54,38361.76],\"first_seen_date\":\"2024-12-24\",\"risk_score\":9,\"risk_history\":[]},{\"vendor_id\":\"V0003\",\"name\":\"Blue Yonder Systems Inc\",\"known_bank_accounts\":[\"ACH-****7172\",\"ACH-****1200\"],\"historical_invoice_amounts\":[32961.9,31564.34,18365.99,30578.45,34897.43,34319.73,25410.29,24146.18,23052.35,26675.83,30868,25645.03,19259.31],\"first_seen_date\":\"2023-03-07\",\"risk_score\":3,\"risk_history\":[]},{\"vendor_id\":\"V0004\",\"name\":\"Parnell Supplies Ltd\",\"known_bank_accounts\":[\"IBAN-DE**21****4229\",\"WIRE-****3419\"],\"historical_invoice_amounts\":[1257.62,2347.99,2446.68,1547.52,1981.14,2044.37,1601.09,2406.59,1329.02,1978.12,2289.02,2514.9,2344.39,2146.89,1377.54,2282.39,2056.35],\"first_seen_date\":\"2026-01-05\",\"risk_score\":3,\"risk_history\":[]},{\"vendor_id\":\"V0005\",\"name\":\"Tru-Fit Holdings Co\",\"known_bank_accounts\":[\"WIRE-****2587\"],\"historical_invoice_amounts\":[18627.04,33508.07,20256.04,29018.76,19505.68,18510.68,13360.21,29014.22,32809.21],\"first_seen_date\":\"2024-02-24\",\"risk_score\":84,\"risk_history\":[{\"date\":\"2024-04-03\",\"event\":\"onboarding_review\",\"decision\":\"reject\",\"note\":\"Flagged: remittance detail mismatch, held for manual verification.\"},{\"date\":\"2024-03-03\",\"event\":\"onboarding_review\",\"decision\":\"reject\",\"note\":\"Flagged: remittance detail mismatch, held for manual verification.\"},{\"date\":\"2024-07-17\",\"event\":\"periodic_review\",\"decision\":\"approve\",\"note\":\"Cleared after review; no action required.\"}]},{\"vendor_id\":\"V0006\",\"name\":\"Wingtip Distribution GmbH\",\"known_bank_accounts\":[\"ACH-****1017\",\"WIRE-****5598\",\"ACH-****2522\"],\"historical_invoice_amounts\":[14642.48,8095.72,10062.02,6557.64,10375.14,10581.93,7244.82,11127.06,15573.89],\"first_seen_date\":\"2023-11-04\",\"risk_score\":23,\"risk_history\":[{\"date\":\"2024-01-02\",\"event\":\"onboarding_review\",\"decision\":\"approve\",\"note\":\"Cleared after review; no action required.\"}]},{\"vendor_id\":\"V0007\",\"name\":\"Trey Industries Co\",\"known_bank_accounts\":[\"WIRE-****4823\"],\"historical_invoice_amounts\":[26019.07,42380.83,48516.91,28674.65,49353.67,19433.08],\"first_seen_date\":\"2026-01-09\",\"risk_score\":26,\"risk_history\":[{\"date\":\"2026-01-26\",\"event\":\"onboarding_review\",\"decision\":\"reject\",\"note\":\"Flagged: remittance detail mismatch, held for manual verification.\"}]},{\"vendor_id\":\"V0008\",\"name\":\"Tru-Fit Solutions Co\",\"known_bank_accounts\":[\"ACH-****2102\"],\"historical_invoice_amounts\":[34057.53],\"first_seen_date\":\"2026-08-05\",\"risk_score\":11,\"risk_history\":[{\"date\":\"2026-08-26\",\"event\":\"onboarding_review\",\"decision\":\"approve\",\"note\":\"Cleared after review; no action required.\"}]},{\"vendor_id\":\"V0009\",\"name\":\"Lucerne Logistics GmbH\",\"known_bank_accounts\":[\"ACH-****3346\",\"IBAN-DE**77****9318\"],\"historical_invoice_amounts\":[1503.07,1300.47,825.06,1411.04,1546.4,1587.66,1049.58,849.41,1267.8,992.65,1359,1026.79,1473.24,1215.63,1335.9],\"first_seen_date\":\"2025-03-20\",\"risk_score\":23,\"risk_history\":[{\"date\":\"2025-06-11\",\"event\":\"onboarding_review\",\"decision\":\"approve\",\"note\":\"Cleared after review; no action required.\"}]},{\"vendor_id\":\"V0010\",\"name\":\"Woodgrove Solutions Group\",\"know