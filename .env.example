# RocketRide development connection (managed by the platform / VS Code extension)
ROCKETRIDE_URI=
ROCKETRIDE_APIKEY=

# RocketRide deployment target (managed by the platform / VS Code extension)
ROCKETRIDE_DEPLOY_URI=
ROCKETRIDE_DEPLOY_APIKEY=

# Payment Fraud Sentinel pipeline (pipelines/payment_fraud_sentinel*.pipe)
# Anthropic API key used by extract_facts (control LLM) and the risk-assessment LLM.
ROCKETRIDE_ANTHROPIC_KEY=your-anthropic-api-key-here

# Required by the managed rocketride_sql / rocketride_* cloud DB nodes.
# The signed-in account identifier (getAccountInfo().userId); the VS Code extension injects it automatically.
ROCKETRIDE_CLIENT_ID=your-rocketride-account-user-id
