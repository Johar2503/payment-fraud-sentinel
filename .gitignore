# --- Secrets: never commit ---
.env
**/.env
.env.local
**/.env.local
api-key.txt
**/api-key.txt

# --- .rocketride/ is platform-provisioned; keep it out EXCEPT the two SDK
#     tarballs package.json resolves, so a clean clone can `npm install`. ---
.rocketride/*
!.rocketride/client
!.rocketride/shell
.rocketride/client/*
!.rocketride/client/rocketride.tgz
.rocketride/shell/*
!.rocketride/shell/shell.tgz

# --- Machine-generated ---
**/node_modules/
**/dist/
*.stackdump
.DS_Store

# working backups
*.bak-*

# stray key / credential / scratch text files
*[Kk]ey*.txt
*[Uu]rl*.txt
*.key
